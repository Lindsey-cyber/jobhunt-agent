# Docker Compose uses its PostgreSQL service. For local smoke tests SQLite is supported.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DASHBOARD_TOKEN=replace-with-a-separate-long-random-password
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Optional gap-filling providers; official ATS/GitHub feeds work without these keys.
BRAVE_API_KEY=
TAVILY_API_KEY=
DAILY_LIMIT=100
AUTO_SUBMIT=false
DISCOVERY_ONLY=true
SCHEDULED_DISCOVERY=false
TIMEZONE=America/New_York
DISCOVERY_INTERVAL=1800
POLL_INTERVAL=30
MAX_ATTEMPTS=3
BROWSER_STEPS=80

SEARCH_QUERIES_PER_CYCLE=12
SOURCES_PER_CYCLE=200
DISCOVERY_CONCURRENCY=6
HTTP_RETRIES=3
HEARTBEAT_INTERVAL=15
WORKER_STALE_SECONDS=90
DISCOVERY_REGISTRY=config/discovery-sources.example.json
CATALOG_SCHEDULED=false
CATALOG_INTERVAL=21600
# Optional independent VPS Gmail readonly OAuth; connected ChatGPT Gmail auth is not exported.
GMAIL_ACCESS_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
