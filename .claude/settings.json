{
  "permissions": {
    "deny": [
      "Edit(data/config.yaml)",
      "Write(data/config.yaml)",
      "Edit(data/ledger.jsonl)",
      "Write(data/ledger.jsonl)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/coordinator-guard.sh" }]
      }
    ]
  }
}
