[Unit]
Description=jobhunt-agent daily coordinator pass (discovery, audit, report)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=jobhunt
Group=jobhunt
WorkingDirectory=/opt/jobhunt-agent
EnvironmentFile=/etc/jobhunt/env
ExecStart=/opt/jobhunt-agent/deploy/daily.sh
# Discovery, ~100 applications (Workday takes minutes each) and the audit; runs are 6 hours apart.
TimeoutStartSec=5h30min
Nice=5
