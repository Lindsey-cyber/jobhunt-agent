[Unit]
Description=Run the jobhunt-agent coordinator three times a day

[Timer]
# The candidate (2026-10-28): noon, 6 pm and midnight, New York time (DST handled by systemd).
# A run still going when the next is due is not started twice (the service is oneshot).
OnCalendar=*-*-* 00,12,18:00:00 America/New_York
RandomizedDelaySec=5min
Persistent=true

[Install]
WantedBy=timers.target
